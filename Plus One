from typing import List

class Solution:
    def plusOne(self, digits: List[int]) -> List[int]:
        num_str = ""
        for digit in digits:
            num_str += str(digit)  
        num = int(num_str) 
        num += 1                  
        result = []
        for char in str(num):
            result.append(int(char))  
        return result
